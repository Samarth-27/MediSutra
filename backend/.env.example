# ===================================================================
# MediSutra Platform - Environment Configuration Template
# NOTE: Never commit sensitive credentials or real secrets to Git.
# ===================================================================

# Server Environment & Port
NODE_ENV=development
PORT=5000

# Authentication & Cryptography (Generate a 64+ char random hex string in production)
JWT_SECRET=replace_with_a_secure_cryptographic_secret_in_production
JWT_EXPIRES_IN=7d

# CORS Allowed Origins (Comma-separated list of trusted origins)
# Example: http://localhost:3000,https://medisutra.onrender.com
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# Rate Limiting Configuration
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20
AI_RATE_LIMIT_MAX=60

# Secure Storage Directory
STORAGE_DIR=./storage/vault
